// Copy this file to include/secrets.h and fill in your values.
// secrets.h is ignored by git.
#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// ntfy server on the local network. Use http:// for a LAN container.
#define NTFY_URL "http://192.168.1.50:80"
#define NTFY_TOPIC "foyer-cat"

// Optional ntfy access token. Leave empty if the server is open.
#define NTFY_TOKEN ""

// Optional token for the reset endpoint. If not empty, requests
// must send the header "X-Token: <value>". Leave empty for no check.
#define RESET_TOKEN ""

// Address of this ESP32, used by the "Reset" button in the alert.
// Give the ESP32 a fixed IP or a DHCP reservation on the router.
#define DEVICE_URL "http://192.168.1.60"
